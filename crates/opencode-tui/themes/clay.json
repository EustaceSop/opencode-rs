{
  "$schema": "https://opencode.ai/theme.json",
  "$comment": "Rust build: warm ivory and charcoal grounds, a clay accent, sage and slate for states.",
  "defs": {
    "darkBg": "#262624",
    "darkPanel": "#2d2c2a",
    "darkElement": "#363532",
    "darkBorderSubtle": "#3e3d39",
    "darkBorder": "#4c4a45",
    "darkBorderActive": "#6b6862",
    "darkText": "#f2f0e8",
    "darkMuted": "#a19e95",
    "darkClay": "#d97757",
    "darkClaySoft": "#e8a487",
    "darkTan": "#d4a27f",
    "darkSage": "#94b47e",
    "darkSlate": "#8fb0d4",
    "darkRed": "#e5715f",
    "darkAmber": "#e2a85c",
    "darkPlum": "#c49ac9",
    "darkLavender": "#aab4f2",
    "lightBg": "#faf9f5",
    "lightPanel": "#f4f2ea",
    "lightElement": "#ece9df",
    "lightBorderSubtle": "#e4e1d6",
    "lightBorder": "#d3cfc2",
    "lightBorderActive": "#b2ad9f",
    "lightText": "#1f1e1d",
    "lightMuted": "#73716a",
    "lightClay": "#c96442",
    "lightClaySoft": "#b4552f",
    "lightTan": "#9c5b3b",
    "lightSage": "#4f7a3d",
    "lightSlate": "#3f6e99",
    "lightRed": "#b53a2c",
    "lightAmber": "#a86b16",
    "lightPlum": "#87508c",
    "lightLavender": "#4c58b0"
  },
  "theme": {
    "primary": { "dark": "darkClay", "light": "lightClay" },
    "secondary": { "dark": "darkSlate", "light": "lightSlate" },
    "accent": { "dark": "darkClaySoft", "light": "lightClaySoft" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkAmber", "light": "lightAmber" },
    "success": { "dark": "darkSage", "light": "lightSage" },
    "info": { "dark": "darkSlate", "light": "lightSlate" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "darkSage", "light": "lightSage" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHighlightAdded": { "dark": "#b5d3a0", "light": "#3d6a2c" },
    "diffHighlightRemoved": { "dark": "#f09a8b", "light": "#9b2c1f" },
    "diffAddedBg": { "dark": "#2e3a2a", "light": "#e4edd9" },
    "diffRemovedBg": { "dark": "#412c27", "light": "#f6e0da" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "#7f7c74", "light": "#8b887f" },
    "diffAddedLineNumberBg": { "dark": "#283324", "light": "#d8e5cb" },
    "diffRemovedLineNumberBg": { "dark": "#392723", "light": "#efd3cb" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkClay", "light": "lightClay" },
    "markdownLink": { "dark": "darkLavender", "light": "lightLavender" },
    "markdownLinkText": { "dark": "darkLavender", "light": "lightLavender" },
    "markdownCode": { "dark": "darkLavender", "light": "lightLavender" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkText", "light": "lightText" },
    "markdownStrong": { "dark": "#ffffff", "light": "#000000" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkClay", "light": "lightClay" },
    "markdownListEnumeration": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownImage": { "dark": "darkClaySoft", "light": "lightClaySoft" },
    "markdownImageText": { "dark": "darkSlate", "light": "lightSlate" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkClay", "light": "lightClay" },
    "syntaxFunction": { "dark": "darkAmber", "light": "lightTan" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "darkSage", "light": "lightSage" },
    "syntaxNumber": { "dark": "darkTan", "light": "lightAmber" },
    "syntaxType": { "dark": "darkSlate", "light": "lightSlate" },
    "syntaxOperator": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxPunctuation": { "dark": "darkMuted", "light": "lightMuted" }
  }
}
